# Copiar a .env y completar. Nunca subir .env a GitHub.
ADMIN_PASSWORD=
PORT=3000
# Dirección accesible por invitados (sin barra final). Para uso local:
# PUBLIC_URL=http://192.168.1.100:3000
# Para servidor en internet:
# PUBLIC_URL=https://fotos.tudominio.com
DATA_DIR=./data
MAX_PHOTOS=3000
UPLOADS_PER_MINUTE=120
# Activar sólo detrás de UN proxy confiable:
# TRUST_PROXY=1
